			primaryColor = #ffffff
			secondaryColor = #ffffff
			GAMEOBJECTS
			{
				round = false
				square = true
			}
		}
		VARIANT
		{
			name = Round
			displayName = #autoLOC_6011099 //Round
			description = #autoLOC_6011099 //Round
			primaryColor = #000000
			secondaryColor = #000000
			GAMEOBJECTS
			{
				round = true
				square = false
			}
		}
	}	
	MODULE
	
	MODULE
	{
		name = ModuleCargoPart
		packedVolume = 320
	}
}
