	en-us
	{
		
		#autoLOC_6002644 = <<1>> dropped. Reminder: This part will only perform its function when deployed by a kerbal.
		#autoLOC_6006033 = Unsuited Kerbal
		#autoLOC_6006034 = <<1>> lvl<<2>>
